---
// Sticky Kopfzeile: Wortmarke links, drei Sprungmarken rechts.
// Auf der Startseite wird direkt zum Abschnitt gescrollt, auf Unterseiten zur Startseite gesprungen.
import { site, nav } from '../data/site';

const isHome = Astro.url.pathname === '/';
const prefix = isHome ? '' : '/';
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="wordmark" href={isHome ? '#top' : '/'} aria-label={`${site.name} – Start`}>
      <span>{site.name}</span>
    </a>
    <nav class="site-nav" aria-label="Hauptnavigation">
      {nav.map((item) => <a href={`${prefix}#${item.hash}`}>{item.label}</a>)}
    </nav>
  </div>
</header>
