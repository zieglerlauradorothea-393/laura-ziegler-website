---
import { site, hero, mailto } from '../data/site';
---

<section class="hero" id="top">
  <div class="hero-inner">
    <div class="hero-copy">
      <!-- Auf dem Desktop eine Zeile; auf dem Handy rückt „Bremen“ ohne Trennpunkt in die zweite Zeile -->
      <p class="eyebrow"><span class="eyebrow-role">{site.role}</span><span class="eyebrow-sep"> · </span><span class="eyebrow-city">{site.city}</span></p>
      <h1 class="hero-intro">{hero.intro}</h1>
      <div class="hero-actions">
        <a class="button" href={mailto}>{hero.cta}</a>
      </div>
    </div>

    <figure class="hero-portrait">
      <div class="portrait-frame">
        <img
          src={hero.image.src}
          alt={hero.image.alt}
          width={hero.image.width}
          height={hero.image.height}
          fetchpriority="high"
        />
      </div>
    </figure>
  </div>
</section>
