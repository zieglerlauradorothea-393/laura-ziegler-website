---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Leistungen from '../components/Leistungen.astro';
import Erfahrung from '../components/Erfahrung.astro';
import Kontakt from '../components/Kontakt.astro';
import { site, hero, leistungen } from '../data/site';

const title = `${site.name} | ${site.role} ${site.city}`;
const description =
  'Projekt- und Veranstaltungsmanagement für Kunst, Kultur und Bildung in Bremen. Planung, Koordination, Fördermittel und Abrechnung – klar geplant und verlässlich umgesetzt.';

const portraitAbsolute = new URL(hero.image.src, site.url).href;

const person = {
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  jobTitle: 'Projekt- und Veranstaltungsmanagerin',
  url: site.url,
  image: portraitAbsolute,
  email: site.email,
  sameAs: [site.linkedin],
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: 'HB',
    addressCountry: 'DE',
  },
  knowsAbout: [
    'Projektmanagement',
    'Veranstaltungsmanagement',
    'Kulturmanagement',
    'Fördermittel',
    'Eventorganisation',
  ],
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    {
      '@type': 'ProfessionalService',
      '@id': `${site.url}/#service`,
      name: `${site.name} – ${site.role}`,
      description,
      url: site.url,
      image: portraitAbsolute,
      email: site.email,
      founder: { '@id': `${site.url}/#person` },
      areaServed: { '@type': 'Country', name: 'Deutschland' },
      address: person.address,
      knowsLanguage: ['de', 'en'],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Leistungen',
        itemListElement: leistungen.map((l) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: l.title },
        })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      name: `${site.name} – ${site.role}`,
      url: site.url,
      description,
      inLanguage: 'de-DE',
      author: { '@id': `${site.url}/#person` },
    },
  ],
};
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={hero.image.src} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <Hero />
  <Leistungen />
  <Erfahrung />
  <Kontakt />
</Layout>
